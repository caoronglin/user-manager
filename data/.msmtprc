# msmtp configuration for Tencent Exmail (企业邮箱)
# 配置说明: 使用SSL加密连接SMTP服务器

# 默认账户
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile /home/crl/code/user/logs/msmtp.log

# 腾讯企业邮箱账户
account tencent_exmail
host smtp.exmail.qq.com
port 465
from copaw@cnortles.top
user copaw@cnortles.top
password 8nE7zDRksETBKM7q
tls_starttls off

# 设置默认账户
account default : tencent_exmail
